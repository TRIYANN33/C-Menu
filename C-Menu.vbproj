<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CMenu</RootNamespace>
    <StartupObject>CMenu.Program</StartupObject>
    <MyType>Empty</MyType>
    <CMenuAssemblyName Condition="'$(CMenuAssemblyName)' == ''">MenuPublier</CMenuAssemblyName>
    <AssemblyName>$(CMenuAssemblyName)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Menu-Autonome/**/*.vb" />
    <EmbeddedResource Include="Menu-Autonome/Program.vb" LogicalName="CMenu.Template.Program.vb" />
    <EmbeddedResource Include="Menu-Autonome/FrmMenuAutonome.vb" LogicalName="CMenu.Template.FrmMenuAutonome.vb" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
  </ItemGroup>
</Project>
